<?xml version="1.0" encoding="utf-8"?>
<!-- Runs are GPS traces of where this person actually goes. They stay on the
     device: out of Google Drive backups and out of device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
